# Public (browser-visible) configuration only. Never put secrets here.
VITE_API_BASE=http://localhost:8080
VITE_OIDC_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_OIDC_AUTHORITY=https://login.microsoftonline.com/<tenant-id>/v2.0
# Optional overrides (default to Entra v2 shapes derived from the authority):
# VITE_OIDC_AUTHORIZE_URL=https://login.microsoftonline.com/<tenant-id>/oauth2/v2.0/authorize
# VITE_OIDC_TOKEN_URL=https://login.microsoftonline.com/<tenant-id>/oauth2/v2.0/token
VITE_OIDC_SCOPES=openid api://fieldday/events.read api://fieldday/events.write
